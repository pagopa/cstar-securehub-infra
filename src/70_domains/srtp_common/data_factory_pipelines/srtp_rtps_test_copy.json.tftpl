{
    "name": "${domain}_rtps_test_copy",
    "properties": {
        "activities": [
            {
                "name": "Clear RtpsTest table",
                "type": "AzureDataExplorerCommand",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "command": ".clear table RtpsTest data",
                    "commandTimeout": "00:20:00"
                },
                "linkedServiceName": {
                    "referenceName": "${domain}-Kusto-${domain}-ls",
                    "type": "LinkedServiceReference"
                }
            },
            {
                "name": "Copy rtps_test collection",
                "type": "Copy",
                "dependsOn": [
                    {
                        "activity": "Clear RtpsTest table",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "CosmosDbMongoDbApiSource",
                        "batchSize": 100,
                        "filter": "{ 'status': 'CREATED' }",
                        "cursorMethods": {
                            "project": "{ '_id': 1, 'noticeNumber': 1, 'amount': 1, 'description': 1, 'expiryDate': 1, 'payerName': 1, 'payerId': 1, 'payeeName': 1, 'payeeId': 1, 'subject': 1, 'savingDateTime': 1, 'serviceProviderDebtor': 1, 'iban': 1, 'payTrxRef': 1, 'flgConf': 1, 'status': 1, 'serviceProviderCreditor': 1, 'operationId': 1, 'eventDispatcher': 1, 'operationDispatcherKey': 1, 'witchId': 1 }"
                        }
                    },
                    "sink": {
                        "type": "AzureDataExplorerSink"
                    },
                    "enableStaging": false,
                    "translator": {
                        "type": "TabularTranslator",
                        "mappings": [
                            {
                                "source": {
                                    "path": "$['_id']['$oid']"
                                },
                                "sink": {
                                    "name": "_id",
                                    "type": "String"
                                }
                            },
                            {
                                "source": {
                                    "path": "$['noticeNumber']"
                                },
                                "sink": {
                                    "name": "noticeNumber",
                                    "type": "String"
                                }
                            },
                            {
                                "source": {
                                    "path": "$['amount']"
                                },
                                "sink": {
                                    "name": "amount",
                                    "type": "Decimal"
                                }
                            },
                            {
                                "source": {
                                    "path": "$['description']"
                                },
                                "sink": {
                                    "name": "description",
                                    "type": "String"
                                }
                            },
                            {
                                "source": {
                                    "path": "$['expiryDate']['$date']"
                                },
                                "sink": {
                                    "name": "expiryDate",
                                    "type": "Int64"
                                }
                            },
                            {
                                "source": {
                                    "path": "$['payerName']"
                                },
                                "sink": {
                                    "name": "payerName",
                                    "type": "String"
                                }
                            },
                            {
                                "source": {
                                    "path": "$['payerId']"
                                },
                                "sink": {
                                    "name": "payerId",
                                    "type": "String"
                                }
                            },
                            {
                                "source": {
                                    "path": "$['payeeName']"
                                },
                                "sink": {
                                    "name": "payeeName",
                                    "type": "String"
                                }
                            },
                            {
                                "source": {
                                    "path": "$['payeeId']"
                                },
                                "sink": {
                                    "name": "payeeId",
                                    "type": "String"
                                }
                            },
                            {
                                "source": {
                                    "path": "$['subject']"
                                },
                                "sink": {
                                    "name": "subject",
                                    "type": "String"
                                }
                            },
                            {
                                "source": {
                                    "path": "$['savingDateTime']['$date']"
                                },
                                "sink": {
                                    "name": "savingDateTime",
                                    "type": "Int64"
                                }
                            },
                            {
                                "source": {
                                    "path": "$['serviceProviderDebtor']"
                                },
                                "sink": {
                                    "name": "serviceProviderDebtor",
                                    "type": "String"
                                }
                            },
                            {
                                "source": {
                                    "path": "$['iban']"
                                },
                                "sink": {
                                    "name": "iban",
                                    "type": "String"
                                }
                            },
                            {
                                "source": {
                                    "path": "$['payTrxRef']"
                                },
                                "sink": {
                                    "name": "payTrxRef",
                                    "type": "String"
                                }
                            },
                            {
                                "source": {
                                    "path": "$['flgConf']"
                                },
                                "sink": {
                                    "name": "flgConf",
                                    "type": "String"
                                }
                            },
                            {
                                "source": {
                                    "path": "$['status']"
                                },
                                "sink": {
                                    "name": "status",
                                    "type": "String"
                                }
                            },
                            {
                                "source": {
                                    "path": "$['serviceProviderCreditor']"
                                },
                                "sink": {
                                    "name": "serviceProviderCreditor",
                                    "type": "String"
                                }
                            },
                            {
                                "source": {
                                    "path": "$['operationId']"
                                },
                                "sink": {
                                    "name": "operationId",
                                    "type": "String"
                                }
                            },
                            {
                                "source": {
                                    "path": "$['eventDispatcher']"
                                },
                                "sink": {
                                    "name": "eventDispatcher",
                                    "type": "String"
                                }
                            },
                            {
                                "source": {
                                    "path": "$['operationDispatcherKey']"
                                },
                                "sink": {
                                    "name": "operationDispatcherKey",
                                    "type": "String"
                                }
                            },
                            {
                                "source": {
                                    "path": "$['witchId']"
                                },
                                "sink": {
                                    "name": "witchId",
                                    "type": "String"
                                }
                            }
                        ],
                        "collectionReference": "",
                        "mapComplexValuesToString": false
                    }
                },
                "inputs": [
                    {
                        "referenceName": "cosmos_${domain}_rtps_test",
                        "type": "DatasetReference"
                    }
                ],
                "outputs": [
                    {
                        "referenceName": "data_explorer_${domain}_rtps",
                        "type": "DatasetReference"
                    }
                ]
            },
            {
                "name": "Upsert copied rtps_test TTL",
                "type": "Copy",
                "dependsOn": [
                    {
                        "activity": "Copy rtps_test collection",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "AzureDataExplorerSource",
                        "query": "RtpsTest | extend expiryDate = unixtime_milliseconds_todatetime(expiryDate) | extend savingDateTime = unixtime_milliseconds_todatetime(savingDateTime) | extend ttl = int(10)"
                    },
                    "sink": {
                        "type": "CosmosDbMongoDbApiSink",
                        "writeBatchSize": 100,
                        "writeBehavior": "upsert"
                    },
                    "enableStaging": false,
                    "translator": {
                        "type": "TabularTranslator",
                        "mappings": [
                            {
                                "source": {
                                    "name": "_id",
                                    "type": "String"
                                },
                                "sink": {
                                    "path": "_id.$oid"
                                }
                            },
                            {
                                "source": {
                                    "name": "ttl",
                                    "type": "Int32"
                                },
                                "sink": {
                                    "path": "$['ttl']"
                                }
                            }
                        ],
                        "collectionReference": "",
                        "mapComplexValuesToString": true
                    }
                },
                "inputs": [
                    {
                        "referenceName": "data_explorer_${domain}_rtps",
                        "type": "DatasetReference"
                    }
                ],
                "outputs": [
                    {
                        "referenceName": "cosmos_${domain}_rtps_test_ttl_sink",
                        "type": "DatasetReference"
                    }
                ]
            }
        ],
        "annotations": []
    },
    "type": "Microsoft.DataFactory/factories/pipelines"
}
