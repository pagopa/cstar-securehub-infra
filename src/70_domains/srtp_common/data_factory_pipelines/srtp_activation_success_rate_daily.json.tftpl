{
  "name": "srtp_activation_success_rate_daily",
  "properties": {
    "parameters": {
      "target_date": {
        "type": "String",
        "defaultValue": ""
      }
    },
    "activities": [
      {
        "name": "Delete previous day data",
        "type": "AzureDataExplorerCommand",
        "policy": {
          "retry": 3,
          "retryIntervalInSeconds": 300
        },
        "typeProperties": {
          "command": ".delete table activation_success_rate records <| let rawDate = '@{pipeline().parameters.target_date}'; let isoDate = iff(strlen(rawDate) == 10 and substring(rawDate, 2, 1) == '-', strcat(substring(rawDate, 6, 4), '-', substring(rawDate, 3, 2), '-', substring(rawDate, 0, 2)), rawDate); let targetDateLabel = iff(isempty(rawDate), startofday(now() + 2h, -1), todatetime(isoDate)); activation_success_rate | where activation_day == targetDateLabel",
          "commandTimeout": "00:10:00"
        },
        "linkedServiceName": {
          "referenceName": "${domain}-Kusto-${domain}-ls",
          "type": "LinkedServiceReference"
        }
      },
      {
        "name": "Ingest activation success rate daily",
        "type": "AzureDataExplorerCommand",
        "policy": {
          "retry": 3,
          "retryIntervalInSeconds": 300
        },
        "dependsOn": [
          {
            "activity": "Delete previous day data",
            "dependencyConditions": [ "Succeeded" ]
          }
        ],
        "typeProperties": {
          "command": ${jsonencode(join(" ", [".set-or-append activation_success_rate <|", replace(replace(replace(queries["activation_success_rate_daily"], "\n", " "), "__LAW_ID__", law_id), "__LAW_NAME__", law_name)]))},
          "commandTimeout": "00:10:00"
        },
        "linkedServiceName": {
          "referenceName": "${domain}-Kusto-${domain}-ls",
          "type": "LinkedServiceReference"
        }
      }
    ]
  }
}
