let pipelineRunId = '@{pipeline().RunId}';
let rawDate = '@{pipeline().parameters.target_date}';
let isoDate = iff(strlen(rawDate) == 10 and substring(rawDate, 2, 1) == '-', strcat(substring(rawDate, 6, 4), '-', substring(rawDate, 3, 2), '-', substring(rawDate, 0, 2)), rawDate);
let targetDateLabel = iff(isempty(rawDate), startofday(now() + 2h, -1), todatetime(isoDate));
let startOfYesterday = targetDateLabel - 2h;
let proxyTraces = cluster('https://ade.loganalytics.io__LAW_ID__').database('__LAW_NAME__').AppTraces;
let logs = proxyTraces
| where TimeGenerated >= startOfYesterday and TimeGenerated < startOfYesterday + 1d
| where AppRoleName == "rtp-sender";
let totalSent = toscalar(logs | where Message startswith "Rtp sent successfully with id:" | summarize count());
let actuals = materialize(
logs
| where Message has "Triggering REJECT transition for RTP" or Message has "Send RTP request rejected for"
| extend DebtorSP = coalesce(extract(@"service_provider:\s*(\S+)", 1, Message), extract(@"Send RTP request rejected for ([^:]+):", 1, Message))
| extend cert_sn = tostring(todynamic(Properties)["certificate_serial_number"])
| extend CertificateSerialNumber = iff(isempty(cert_sn), "N/A", cert_sn)
| extend TipoRifiuto = case(
    Message has "Triggering REJECT transition for RTP", "Callback (Payer/PSP)",
    Message has "Send RTP request rejected for", "Send/EPC (PSP)",
    "Altro Rifiuto")
| summarize refusals = count() by refusal_type = TipoRifiuto, debtor_service_provider = iff(isempty(DebtorSP), "UNKNOWN", DebtorSP), certificate_serial_number = CertificateSerialNumber, window_start = targetDateLabel
| extend total_sent = coalesce(totalSent, tolong(0))
| extend refusal_rate_percentage = round(todouble(refusals) * 100.0 / iff(total_sent == 0, 1.0, todouble(total_sent)), 2)
| extend is_dummy = 0, pipeline_run_id = pipelineRunId
);
let default_row = print window_start = targetDateLabel, refusal_type = "None", debtor_service_provider = "UNKNOWN", certificate_serial_number = "N/A", refusals = tolong(0), total_sent = tolong(0), refusal_rate_percentage = todouble(0), is_dummy = 1, pipeline_run_id = pipelineRunId;
union actuals, default_row
| where toscalar(actuals | count) == 0 or is_dummy == 0
| order by refusals desc
| project window_start, refusal_type, debtor_service_provider, refusals, total_sent, refusal_rate_percentage, certificate_serial_number, pipeline_run_id
