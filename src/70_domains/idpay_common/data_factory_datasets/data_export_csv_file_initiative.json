{
  "name": "data_export_csv_file_initiative",
  "properties": {
    "linkedServiceName": {
      "referenceName": "${domain}-exports-blobfs-ls",
      "type": "LinkedServiceReference"
    },
    "parameters": {
      "initiativeId": { "type": "String" }
    },
    "annotations": [],
    "type": "Binary",
    "typeProperties": {
      "location": {
        "type": "AzureBlobFSLocation",
        "fileName": {
          "value": "@concat('export_daily_', formatDateTime(utcNow(), 'yyyy-MM-dd'), '.csv')",
          "type": "Expression"
        },
        "folderPath": {
          "value": "@concat('data/', dataset().initiativeId)",
          "type": "Expression"
        },
        "fileSystem": "export"
      }
    }
  },
  "type": "Microsoft.DataFactory/factories/datasets"
}
