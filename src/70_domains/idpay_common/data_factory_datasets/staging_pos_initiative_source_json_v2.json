{
  "name": "staging_pos_initiative_source_json_v2",
  "properties": {
    "linkedServiceName": {
      "referenceName": "${domain}-exports-blobfs-ls",
      "type": "LinkedServiceReference"
    },
    "parameters": {
      "initiativeId": {
        "type": "String"
      }
    },
    "annotations": [
      "POS Initiative Stage v2",
      "IdPay",
      "Multi-Initiative"
    ],
    "type": "Json",
    "typeProperties": {
      "location": {
        "type": "AzureBlobFSLocation",
        "fileName": "active_pos_initiative.json",
        "folderPath": {
          "value": "@concat('staging/pos/common/', dataset().initiativeId)",
          "type": "Expression"
        },
        "fileSystem": "export"
      },
      "encodingName": "UTF-8"
    }
  },
  "type": "Microsoft.DataFactory/factories/datasets"
}
