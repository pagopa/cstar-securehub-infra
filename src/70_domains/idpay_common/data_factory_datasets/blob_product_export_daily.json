{
    "name": "blob_product_export_daily",
    "properties": {
        "linkedServiceName": {
            "referenceName": "${domain}-bonus-blob-storage-ls",
            "type": "LinkedServiceReference"
        },
        "parameters": {
            "fileName": {
                "type": "String"
            },
            "initiativeFolder": {
                "type": "String"
            }
        },
        "annotations": [
            "Products Export",
            "IdPay",
            "EIE",
            "Bonus Elettrodomestici"
        ],
        "type": "Json",
        "typeProperties": {
            "location": {
                "type": "AzureBlobStorageLocation",
                "fileName": {
                    "value": "@dataset().fileName",
                    "type": "Expression"
                },
                "folderPath": {
                    "value": "@concat(dataset().initiativeFolder, '/data')",
                    "type": "Expression"
                },
                "container": "$web"
            },
            "encodingName": "UTF-8"
        },
        "schema": {
            "type": "object",
            "properties": {
                "gtin": {
                    "type": "string"
                },
                "model": {
                    "type": "string"
                },
                "category": {
                    "type": "string"
                },
                "brand": {
                    "type": "string"
                },
                "eprelCode": {
                    "type": "string"
                },
                "countryOfProduction": {
                    "type": "string"
                },
                "energyClass": {
                    "type": "string"
                },
                "capacity": {
                    "type": "string"
                },
                "productName": {
                    "type": "string"
                }
            }
        }
    },
    "type": "Microsoft.DataFactory/factories/datasets"
}
