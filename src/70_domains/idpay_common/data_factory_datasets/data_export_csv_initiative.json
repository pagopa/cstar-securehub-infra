{
  "name": "data_export_csv_initiative",
  "properties": {
    "linkedServiceName": {
      "referenceName": "${domain}-multi-initiative-blob-storage-ls",
      "type": "LinkedServiceReference"
    },
    "parameters": {
      "initiativeFolder": { "type": "String" },
      "initiativeId": { "type": "String" }
    },
    "annotations": [],
    "type": "DelimitedText",
    "typeProperties": {
      "location": {
        "type": "AzureBlobStorageLocation",
        "fileName": {
          "value": "@concat('export_daily_', dataset().initiativeId, '_', formatDateTime(convertTimeZone(utcNow(), 'UTC', 'W. Europe Standard Time'), 'yyyy-MM-dd'), '.csv')",
          "type": "Expression"
        },
        "folderPath": {
          "value": "@concat(dataset().initiativeFolder, '/elenco-prodotti/data')",
          "type": "Expression"
        },
        "container": "$web"
      },
      "columnDelimiter": ",",
      "escapeChar": "\\",
      "firstRowAsHeader": true,
      "quoteChar": "\""
    },
    "schema": []
  },
  "type": "Microsoft.DataFactory/factories/datasets"
}
