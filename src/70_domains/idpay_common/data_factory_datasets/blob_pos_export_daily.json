{
    "name": "blob_pos_export_daily",
    "properties": {
        "linkedServiceName": {
            "referenceName": "${domain}-bonus-blob-storage-ls",
            "type": "LinkedServiceReference"
        },
        "parameters": {
            "fileName": {
                "type": "String"
            },
            "initiativeFolder": {
                "type": "String"
            }
        },
        "annotations": [
            "Point of Sales Export",
            "IdPay",
            "Merchant",
            "Bonus Elettrodomestici"
        ],
        "type": "Json",
        "typeProperties": {
            "location": {
                "type": "AzureBlobStorageLocation",
                "fileName": {
                    "value": "@dataset().fileName",
                    "type": "Expression"
                },
                "folderPath": {
                    "value": "@concat(dataset().initiativeFolder, '/data')",
                    "type": "Expression"
                },
                "container": "$web"
            },
            "encodingName": "UTF-8"
        }
    },
    "type": "Microsoft.DataFactory/factories/datasets"
}
