{
  "name": "blob_onboarding_census_check_json",
  "properties": {
    "description": "Onboarding census pre-check sink: the Copy that looks for real onboardings writes the matching _id here (at most one document). Only rowsRead of the Copy is used. Cleaned by the container lifecycle policy (BND-2482)",
    "linkedServiceName": {
      "referenceName": "${domain}-onboarding-census-blob-ls",
      "type": "LinkedServiceReference"
    },
    "parameters": {
      "initiativeId": { "type": "String" },
      "runId": { "type": "String" }
    },
    "annotations": [
      "Onboarding Census",
      "IdPay"
    ],
    "type": "Json",
    "typeProperties": {
      "location": {
        "type": "AzureBlobStorageLocation",
        "fileName": "check.json",
        "folderPath": {
          "value": "@concat('check/', dataset().initiativeId, '/', dataset().runId)",
          "type": "Expression"
        },
        "container": "onboarding-census"
      },
      "encodingName": "UTF-8"
    }
  },
  "type": "Microsoft.DataFactory/factories/datasets"
}
