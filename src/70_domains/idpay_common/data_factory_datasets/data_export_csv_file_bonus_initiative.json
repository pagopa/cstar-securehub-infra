{
  "name": "data_export_csv_file_bonus_initiative",
  "properties": {
    "linkedServiceName": {
      "referenceName": "${domain}-bonus-blob-storage-ls",
      "type": "LinkedServiceReference"
    },
    "parameters": {
      "initiativeFolder": { "type": "String" }
    },
    "annotations": [],
    "type": "Binary",
    "typeProperties": {
      "location": {
        "type": "AzureBlobStorageLocation",
        "fileName": {
          "value": "@concat('export_daily_', formatDateTime(utcNow(), 'yyyy-MM-dd'), '.csv')",
          "type": "Expression"
        },
        "folderPath": {
          "value": "@concat(dataset().initiativeFolder, '/data')",
          "type": "Expression"
        },
        "container": "$web"
      }
    }
  },
  "type": "Microsoft.DataFactory/factories/datasets"
}
