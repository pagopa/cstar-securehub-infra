{
  "name": "idpay_transaction_report_load_test",
  "properties": {
    "description": "Load test pipeline that triggers idpay_transaction_report multiple times with different parameters",
    "activities": [
      {
        "name": "RunTransactionReportInParallel",
        "type": "ForEach",
        "dependsOn": [],
        "userProperties": [],
        "typeProperties": {
          "isSequential": false,
          "batchCount": 10,
          "items": {
            "value": "@pipeline().parameters.testCases",
            "type": "Expression"
          },
          "activities": [
            {
              "name": "ExecuteTransactionReport",
              "type": "ExecutePipeline",
              "dependsOn": [],
              "policy": {
                "timeout": "02:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "userProperties": [],
              "typeProperties": {
                "pipeline": {
                  "referenceName": "idpay_transaction_report",
                  "type": "PipelineReference"
                },
                "waitOnCompletion": true,
                "parameters": {
                  "initiativeId": {
                    "value": "@item().initiativeId",
                    "type": "Expression"
                  },
                  "merchantId": {
                    "value": "@item().merchantId",
                    "type": "Expression"
                  },
                  "reportId": {
                    "value": "@item().reportId",
                    "type": "Expression"
                  },
                  "reportName": {
                    "value": "@item().reportName",
                    "type": "Expression"
                  },
                  "startDate": {
                    "value": "@item().startDate",
                    "type": "Expression"
                  },
                  "endDate": {
                    "value": "@item().endDate",
                    "type": "Expression"
                  }
                }
              }
            }
          ]
        }
      }
    ],
    "parameters": {
      "testCases": {
        "type": "Array",
        "defaultValue": []
      }
    },
    "annotations": [
      "load-test",
      "idpay",
      "transaction-report"
    ]
  },
  "type": "Microsoft.DataFactory/factories/pipelines"
}
