{
  "name": "idpay_copy_rdb_products_to_csv",
  "properties": {
    "activities": [
      {
        "name": "Lookup_Refresh_Status",
        "type": "Lookup",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "AzureDataExplorerSource",
            "query": "export_refresh_status | where datasetName == \"products\" | top 1 by refreshTimestamp desc | where status == \"SUCCESS\" and refreshTimestamp > ago(24h)"
          },
          "dataset": {
            "referenceName": "data_explorer_export_refresh_status",
            "type": "DatasetReference"
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "Validate_Products_Refresh",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "Lookup_Refresh_Status",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "value": "@greater(activity('Lookup_Refresh_Status').output.count, 0)",
            "type": "Expression"
          },
          "ifTrueActivities": [],
          "ifFalseActivities": [
            {
              "name": "Fail_Products_Refresh",
              "type": "Fail",
              "dependsOn": [],
              "typeProperties": {
                "message": "Required ADX dataset refresh not found.",
                "errorCode": "ProductsRefreshNotFound"
              }
            }
          ]
        }
      },
      {
        "name": "Lookup_Initiative_Export_Configuration",
        "type": "Lookup",
        "dependsOn": [
          {
            "activity": "Validate_Products_Refresh",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "AzureDataExplorerSource",
            "query": {
              "value": "@concat('initiative_export_configuration | where initiativeId == \"', pipeline().parameters.initiativeId, '\" | project fieldsCsv = strcat_array(exportConfiguration.fields, \",\")')",
              "type": "Expression"
            }
          },
          "dataset": {
            "referenceName": "data_explorer_initiative_export_configuration",
            "type": "DatasetReference"
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "Validate_Initiative_Export_Configuration",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "Lookup_Initiative_Export_Configuration",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "value": "@greater(activity('Lookup_Initiative_Export_Configuration').output.count, 0)",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "name": "Copy_ADX_to_CSV",
              "type": "Copy",
              "dependsOn": [],
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "userProperties": [],
              "typeProperties": {
                "source": {
                  "type": "AzureDataExplorerSource",
                  "query": {
                    "value": "@concat('let translated = category_translation | where initiativeId == \"', pipeline().parameters.initiativeId, '\" and language == \"it\" | project categoryCode = tostring(categoryCode), categoryDescription = tostring(description); products | where status == \"APPROVED\" and initiativeId == \"', pipeline().parameters.initiativeId, '\" | extend category = tostring(category) | join kind=leftouter translated on $left.category == $right.categoryCode | extend category = iff(isempty(categoryDescription), category, categoryDescription) | project ', activity('Lookup_Initiative_Export_Configuration').output.value[0].fieldsCsv)",
                    "type": "Expression"
                  }
                },
                "sink": {
                  "type": "DelimitedTextSink",
                  "storeSettings": {
                    "type": "AzureBlobFSWriteSettings",
                    "copyBehavior": "FlattenHierarchy"
                  },
                  "formatSettings": {
                    "type": "DelimitedTextWriteSettings",
                    "quoteAllText": true,
                    "fileExtension": ".csv"
                  }
                },
                "enableStaging": false
              },
              "inputs": [
                {
                  "referenceName": "data_explorer_rdb_products",
                  "type": "DatasetReference"
                }
              ],
              "outputs": [
                {
                  "referenceName": "data_export_csv_initiative",
                  "type": "DatasetReference",
                  "parameters": {
                    "initiativeId": "@pipeline().parameters.initiativeId"
                  }
                }
              ]
            },
            {
              "name": "Copy_To_Bonus",
              "type": "Copy",
              "dependsOn": [
                {
                  "activity": "Copy_ADX_to_CSV",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "policy": {
                "timeout": "0.01:00:00",
                "retry": 2,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "userProperties": [],
              "typeProperties": {
                "source": {
                  "type": "BinarySource"
                },
                "sink": {
                  "type": "BinarySink"
                },
                "enableStaging": false
              },
              "inputs": [
                {
                  "referenceName": "data_export_csv_file_initiative",
                  "type": "DatasetReference",
                  "parameters": {
                    "initiativeId": "@pipeline().parameters.initiativeId"
                  }
                }
              ],
              "outputs": [
                {
                  "referenceName": "data_export_csv_file_bonus_initiative",
                  "type": "DatasetReference",
                  "parameters": {
                    "initiativeFolder": "@pipeline().parameters.initiativeFolder",
                    "initiativeId": "@pipeline().parameters.initiativeId"
                  }
                }
              ]
            }
          ],
          "ifFalseActivities": [
            {
              "name": "Fail_Initiative_Export_Configuration",
              "type": "Fail",
              "dependsOn": [],
              "typeProperties": {
                "message": "Initiative export configuration not found.",
                "errorCode": "InitiativeExportConfigurationNotFound"
              }
            }
          ]
        }
      },
      {
        "name": "Generate_SAS",
        "type": "WebActivity",
        "state": "Inactive",
        "onInactiveMarkAs": "Succeeded",
        "dependsOn": [
          {
            "activity": "Validate_Initiative_Export_Configuration",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:05:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": true,
          "secureInput": true
        },
        "userProperties": [],
        "typeProperties": {
          "method": "POST",
          "headers": {
            "Content-Type": "application/json"
          },
          "url": {
            "value": "@concat('https://management.azure.com/subscriptions/', string(pipeline().parameters.subscriptionId), '/resourceGroups/', string(pipeline().parameters.resourceGroup), '/providers/Microsoft.Storage/storageAccounts/', string(pipeline().parameters.exportAccountName), '/ListServiceSas?api-version=2023-05-01')",
            "type": "Expression"
          },
          "connectVia": {
            "referenceName": "AutoResolveIntegrationRuntime",
            "type": "IntegrationRuntimeReference"
          },
          "body": {
            "canonicalizedResource": {
              "type": "Expression",
              "value": "@concat('/blob/', pipeline().parameters.exportAccountName, '/', pipeline().parameters.initiativeFolder, '/data/export_daily_', pipeline().parameters.initiativeId, '_', formatDateTime(utcNow(),'yyyy-MM-dd'), '.csv')"
            },
            "signedExpiry": {
              "type": "Expression",
              "value": "@formatDateTime(addDays(utcNow(), 7), 'yyyy-MM-ddTHH:mm:ssZ')"
            },
            "signedResource": "b",
            "signedPermission": "r",
            "signedProtocol": "https",
            "signedStart": {
              "type": "Expression",
              "value": "@utcNow()"
            },
            "signedVersion": "2020-02-10"
          },
          "authentication": {
            "type": "MSI",
            "resource": "https://management.azure.com/"
          }
        }
      },
      {
        "name": "Get_SubKey",
        "type": "WebActivity",
        "state": "Inactive",
        "onInactiveMarkAs": "Succeeded",
        "dependsOn": [
          {
            "activity": "Generate_SAS",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:02:00",
          "retry": 3,
          "retryIntervalInSeconds": 30,
          "secureOutput": true,
          "secureInput": true
        },
        "userProperties": [],
        "typeProperties": {
          "method": "GET",
          "headers": {
            "Content-Type": "application/json"
          },
          "disableCertValidation": false,
          "url": {
            "value": "@concat(pipeline().parameters.kvUrl,'/secrets/', pipeline().parameters.kvSecretName, '?api-version=7.3')",
            "type": "Expression"
          },
          "connectVia": {
            "referenceName": "AutoResolveIntegrationRuntime",
            "type": "IntegrationRuntimeReference"
          },
          "authentication": {
            "type": "MSI",
            "resource": "https://vault.azure.net"
          }
        }
      },
      {
        "name": "Get_NotifyTo",
        "type": "WebActivity",
        "state": "Inactive",
        "onInactiveMarkAs": "Succeeded",
        "dependsOn": [
          {
            "activity": "Get_SubKey",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:02:00",
          "retry": 3,
          "retryIntervalInSeconds": 30,
          "secureOutput": true,
          "secureInput": true
        },
        "userProperties": [],
        "typeProperties": {
          "method": "GET",
          "headers": {
            "Content-Type": "application/json"
          },
          "disableCertValidation": false,
          "url": {
            "value": "@concat(pipeline().parameters.kvUrl,'/secrets/', pipeline().parameters.notifyToSecretName, '?api-version=7.3')",
            "type": "Expression"
          },
          "connectVia": {
            "referenceName": "AutoResolveIntegrationRuntime",
            "type": "IntegrationRuntimeReference"
          },
          "authentication": {
            "type": "MSI",
            "resource": "https://vault.azure.net"
          }
        }
      },
      {
        "name": "Notify_Email_via_MS",
        "type": "WebActivity",
        "state": "Inactive",
        "onInactiveMarkAs": "Succeeded",
        "dependsOn": [
          {
            "activity": "Get_NotifyTo",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:05:00",
          "retry": 3,
          "retryIntervalInSeconds": 30,
          "secureOutput": true,
          "secureInput": true
        },
        "userProperties": [],
        "typeProperties": {
          "method": "POST",
          "headers": {
            "Content-Type": "application/json",
            "Ocp-Apim-Subscription-Key": {
              "value": "@activity('Get_SubKey').output.value",
              "type": "Expression"
            }
          },
          "url": {
            "value": "@pipeline().parameters.notifyUrl",
            "type": "Expression"
          },
          "connectVia": {
            "referenceName": "AutoResolveIntegrationRuntime",
            "type": "IntegrationRuntimeReference"
          },
          "body": {
            "recipientEmail": {
              "type": "Expression",
              "value": "@activity('Get_NotifyTo').output.value"
            },
            "subject": {
              "type": "Expression",
              "value": "@concat('Export giornaliero dei prodotti ', formatDateTime(utcNow(),'yyyy-MM-dd'))"
            },
            "templateName": "Email_ExportDaily_Products",
            "templateValues": {
              "downloadLink": {
                "type": "Expression",
                "value": "@concat('https://', pipeline().parameters.exportAccountName, '.blob.core.windows.net/$web/', pipeline().parameters.initiativeFolder, '/data/export_daily_', pipeline().parameters.initiativeId, '_', formatDateTime(utcNow(),'yyyy-MM-dd'), '.csv?', activity('Generate_SAS').output.serviceSasToken)"
              },
              "exportDate": {
                "type": "Expression",
                "value": "@formatDateTime(utcNow(),'yyyy-MM-dd')"
              },
              "initiativeName": {
                "type": "Expression",
                "value": "@pipeline().parameters.initiativeName"
              },
              "orgName": "PagoPA S.p.A.",
              "productFileName": {
                "type": "Expression",
                "value": "@concat('export_daily_', pipeline().parameters.initiativeId, '_', formatDateTime(utcNow(),'yyyy-MM-dd'), '.csv')"
              }
            }
          }
        }
      }
    ],
    "parameters": {
      "exportAccountName": {
        "type": "String"
      },
      "initiativeFolder": {
        "type": "String"
      },
      "initiativeId": {
        "type": "String"
      },
      "initiativeName": {
        "type": "String"
      },
      "kvSecretName": {
        "type": "String"
      },
      "kvUrl": {
        "type": "String"
      },
      "notifyToSecretName": {
        "type": "String"
      },
      "notifyUrl": {
        "type": "String"
      },
      "resourceGroup": {
        "type": "String"
      },
      "subscriptionId": {
        "type": "String"
      }
    },
    "annotations": []
  },
  "type": "Microsoft.DataFactory/factories/pipelines"
}
