{
  "name": "idpay_copy_rdb_products_to_csv",
  "properties": {
    "activities": [
      {
        "name": "Lookup_Refresh_Status",
        "type": "Lookup",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "AzureDataExplorerSource",
            "query": "export_refresh_status | where datasetName == \"products\" | where status == \"SUCCESS\" | where refreshTimestamp > ago(24h) | top 1 by refreshTimestamp desc"
          },
          "dataset": {
            "referenceName": "data_explorer_export_refresh_status",
            "type": "DatasetReference"
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "Validate_Products_Refresh",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "Lookup_Refresh_Status",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "value": "@greater(activity('Lookup_Refresh_Status').output.count, 0)",
            "type": "Expression"
          },
          "ifTrueActivities": [],
          "ifFalseActivities": [
            {
              "name": "Fail_Products_Refresh",
              "type": "Fail",
              "dependsOn": [],
              "typeProperties": {
                "message": "Required ADX dataset refresh not found.",
                "errorCode": "ProductsRefreshNotFound"
              }
            }
          ]
        }
      },
      {
        "name": "Lookup_Initiative_Export_Configuration",
        "type": "Lookup",
        "dependsOn": [
          {
            "activity": "Validate_Products_Refresh",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "AzureDataExplorerSource",
            "query": {
              "value": "@concat('initiative_export_configuration | where initiativeId == \"', pipeline().parameters.initiativeId, '\"')",
              "type": "Expression"
            }
          },
          "dataset": {
            "referenceName": "data_explorer_initiative_export_configuration",
            "type": "DatasetReference"
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "Route_CSV_Export",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "Lookup_Initiative_Export_Configuration",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "value": "@greater(activity('Lookup_Initiative_Export_Configuration').output.count, 0)",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "name": "If_BonusDecoder",
              "type": "IfCondition",
              "dependsOn": [],
              "typeProperties": {
                "expression": {
                  "value": "@equals(pipeline().parameters.initiativeId, 'bonusdecoder')",
                  "type": "Expression"
                },
                "ifTrueActivities": [
                  {
                    "name": "Copy_Cosmos_to_CSV_BonusDecoder",
                    "type": "Copy",
                    "dependsOn": [],
                    "policy": {
                      "timeout": "0.12:00:00",
                      "retry": 0,
                      "retryIntervalInSeconds": 30,
                      "secureOutput": false,
                      "secureInput": false
                    },
                    "userProperties": [],
                    "typeProperties": {
                      "source": {
                        "type": "CosmosDbMongoDbApiSource",
                        "batchSize": 100,
                        "filter": {
                          "value": "@concat('{ \"status\": \"APPROVED\", \"initiativeId\": \"', pipeline().parameters.initiativeId, '\" }')",
                          "type": "Expression"
                        },
                        "cursorMethods": {
                          "project": "{ \"_id\": 0, \"gtinCode\": 1, \"model\": 1, \"brand\": 1, \"productName\": 1, \"category\": 1, \"productCode\": 1 }"
                        }
                      },
                      "sink": {
                        "type": "DelimitedTextSink",
                        "storeSettings": {
                          "type": "AzureBlobFSWriteSettings",
                          "copyBehavior": "FlattenHierarchy"
                        },
                        "formatSettings": {
                          "type": "DelimitedTextWriteSettings",
                          "quoteAllText": true,
                          "fileExtension": ".txt"
                        }
                      },
                      "enableStaging": false,
                      "translator": {
                        "type": "TabularTranslator",
                        "mappings": [
                          {
                            "source": { "path": "$['gtinCode']" },
                            "sink": { "name": "gtinCode", "type": "String" }
                          },
                          {
                            "source": { "path": "$['model']" },
                            "sink": { "name": "model", "type": "String" }
                          },
                          {
                            "source": { "path": "$['brand']" },
                            "sink": { "name": "brand", "type": "String" }
                          },
                          {
                            "source": { "path": "$['productName']" },
                            "sink": { "name": "productName", "type": "String" }
                          },
                          {
                            "source": { "path": "$['category']" },
                            "sink": { "name": "category", "type": "String" }
                          },
                          {
                            "source": { "path": "$['productCode']" },
                            "sink": { "name": "productCode", "type": "String" }
                          }
                        ],
                        "mapComplexValuesToString": false
                      }
                    },
                    "inputs": [
                      {
                        "referenceName": "cosmos_rdb_products",
                        "type": "DatasetReference"
                      }
                    ],
                    "outputs": [
                      {
                        "referenceName": "data_export_csv_initiative",
                        "type": "DatasetReference",
                        "parameters": {
                          "initiativeId": "@pipeline().parameters.initiativeId"
                        }
                      }
                    ]
                  },
                  {
                    "name": "FlussoExportCSV_BonusDecoder",
                    "type": "ExecuteDataFlow",
                    "dependsOn": [
                      {
                        "activity": "Copy_Cosmos_to_CSV_BonusDecoder",
                        "dependencyConditions": [
                          "Succeeded"
                        ]
                      }
                    ],
                    "policy": {
                      "timeout": "0.12:00:00",
                      "retry": 0,
                      "retryIntervalInSeconds": 30,
                      "secureOutput": false,
                      "secureInput": false
                    },
                    "userProperties": [],
                    "typeProperties": {
                      "dataFlow": {
                        "referenceName": "export_flow_csv_bonusdecoder",
                        "type": "DataFlowReference",
                        "datasetParameters": {
                          "ImportCSV": {
                            "initiativeId": "@pipeline().parameters.initiativeId"
                          },
                          "CSVTransformed": {
                            "initiativeId": "@pipeline().parameters.initiativeId"
                          }
                        }
                      },
                      "compute": {
                        "coreCount": 8,
                        "computeType": "General"
                      },
                      "traceLevel": "Fine"
                    }
                  },
                  {
                    "name": "Copy_To_Bonus_BonusDecoder",
                    "type": "Copy",
                    "dependsOn": [
                      {
                        "activity": "FlussoExportCSV_BonusDecoder",
                        "dependencyConditions": [
                          "Succeeded"
                        ]
                      }
                    ],
                    "policy": {
                      "timeout": "0.01:00:00",
                      "retry": 2,
                      "retryIntervalInSeconds": 30,
                      "secureOutput": false,
                      "secureInput": false
                    },
                    "userProperties": [],
                    "typeProperties": {
                      "source": {
                        "type": "BinarySource"
                      },
                      "sink": {
                        "type": "BinarySink"
                      },
                      "enableStaging": false
                    },
                    "inputs": [
                      {
                        "referenceName": "data_export_csv_file_initiative",
                        "type": "DatasetReference",
                        "parameters": {
                          "initiativeId": "@pipeline().parameters.initiativeId"
                        }
                      }
                    ],
                    "outputs": [
                      {
                        "referenceName": "data_export_csv_file_bonus_initiative",
                        "type": "DatasetReference",
                        "parameters": {
                          "initiativeFolder": "@pipeline().parameters.initiativeFolder",
                          "initiativeId": "@pipeline().parameters.initiativeId"
                        }
                      }
                    ]
                  }
                ],
                "ifFalseActivities": [
                  {
                    "name": "If_Bonuselettrodomestici",
                    "type": "IfCondition",
                    "dependsOn": [],
                    "typeProperties": {
                      "expression": {
                        "value": "@equals(pipeline().parameters.initiativeId, 'bonuselettrodomestici')",
                        "type": "Expression"
                      },
                      "ifTrueActivities": [
                        {
                          "name": "Copy_Cosmos_to_CSV_Bonuselettrodomestici",
                          "type": "Copy",
                          "dependsOn": [],
                          "policy": {
                            "timeout": "0.12:00:00",
                            "retry": 0,
                            "retryIntervalInSeconds": 30,
                            "secureOutput": false,
                            "secureInput": false
                          },
                          "userProperties": [],
                          "typeProperties": {
                            "source": {
                              "type": "CosmosDbMongoDbApiSource",
                              "batchSize": 100,
                              "filter": {
                                "value": "@concat('{ \"status\": \"APPROVED\", \"initiativeId\": \"', pipeline().parameters.initiativeId, '\" }')",
                                "type": "Expression"
                              },
                              "cursorMethods": {
                                "project": "{ \"_id\": 0, \"gtinCode\": 1, \"model\": 1, \"brand\": 1, \"eprelCode\": 1, \"countryOfProduction\": 1, \"energyClass\": 1, \"capacity\": 1, \"productName\": 1, \"category\": 1, \"productGroup\": 1, \"productCode\": 1 }"
                              }
                            },
                            "sink": {
                              "type": "DelimitedTextSink",
                              "storeSettings": {
                                "type": "AzureBlobFSWriteSettings",
                                "copyBehavior": "FlattenHierarchy"
                              },
                              "formatSettings": {
                                "type": "DelimitedTextWriteSettings",
                                "quoteAllText": true,
                                "fileExtension": ".txt"
                              }
                            },
                            "enableStaging": false,
                            "translator": {
                              "type": "TabularTranslator",
                              "mappings": [
                                {
                                  "source": { "path": "$['gtinCode']" },
                                  "sink": { "name": "gtinCode", "type": "String" }
                                },
                                {
                                  "source": { "path": "$['model']" },
                                  "sink": { "name": "model", "type": "String" }
                                },
                                {
                                  "source": { "path": "$['brand']" },
                                  "sink": { "name": "brand", "type": "String" }
                                },
                                {
                                  "source": { "path": "$['eprelCode']" },
                                  "sink": { "name": "eprelCode", "type": "String" }
                                },
                                {
                                  "source": { "path": "$['countryOfProduction']" },
                                  "sink": { "name": "countryOfProduction", "type": "String" }
                                },
                                {
                                  "source": { "path": "$['energyClass']" },
                                  "sink": { "name": "energyClass", "type": "String" }
                                },
                                {
                                  "source": { "path": "$['capacity']" },
                                  "sink": { "name": "capacity", "type": "String" }
                                },
                                {
                                  "source": { "path": "$['productName']" },
                                  "sink": { "name": "productName", "type": "String" }
                                },
                                {
                                  "source": { "path": "$['category']" },
                                  "sink": { "name": "category", "type": "String" }
                                },
                                {
                                  "source": { "path": "$['productGroup']" },
                                  "sink": { "name": "productGroup", "type": "String" }
                                },
                                {
                                  "source": { "path": "$['productCode']" },
                                  "sink": { "name": "productCode", "type": "String" }
                                }
                              ],
                              "mapComplexValuesToString": false
                            }
                          },
                          "inputs": [
                            {
                              "referenceName": "cosmos_rdb_products",
                              "type": "DatasetReference"
                            }
                          ],
                          "outputs": [
                            {
                              "referenceName": "data_export_csv_initiative",
                              "type": "DatasetReference",
                              "parameters": {
                                "initiativeId": "@pipeline().parameters.initiativeId"
                              }
                            }
                          ]
                        },
                        {
                          "name": "FlussoExportCSV_Bonuselettrodomestici",
                          "type": "ExecuteDataFlow",
                          "dependsOn": [
                            {
                              "activity": "Copy_Cosmos_to_CSV_Bonuselettrodomestici",
                              "dependencyConditions": [
                                "Succeeded"
                              ]
                            }
                          ],
                          "policy": {
                            "timeout": "0.12:00:00",
                            "retry": 0,
                            "retryIntervalInSeconds": 30,
                            "secureOutput": false,
                            "secureInput": false
                          },
                          "userProperties": [],
                          "typeProperties": {
                            "dataFlow": {
                              "referenceName": "export_flow_csv_bonuselettrodomestici",
                              "type": "DataFlowReference",
                              "datasetParameters": {
                                "ImportCSV": {
                                  "initiativeId": "@pipeline().parameters.initiativeId"
                                },
                                "CSVTransformed": {
                                  "initiativeId": "@pipeline().parameters.initiativeId"
                                }
                              }
                            },
                            "compute": {
                              "coreCount": 8,
                              "computeType": "General"
                            },
                            "traceLevel": "Fine"
                          }
                        },
                        {
                          "name": "Copy_To_Bonus_Bonuselettrodomestici",
                          "type": "Copy",
                          "dependsOn": [
                            {
                              "activity": "FlussoExportCSV_Bonuselettrodomestici",
                              "dependencyConditions": [
                                "Succeeded"
                              ]
                            }
                          ],
                          "policy": {
                            "timeout": "0.01:00:00",
                            "retry": 2,
                            "retryIntervalInSeconds": 30,
                            "secureOutput": false,
                            "secureInput": false
                          },
                          "userProperties": [],
                          "typeProperties": {
                            "source": {
                              "type": "BinarySource"
                            },
                            "sink": {
                              "type": "BinarySink"
                            },
                            "enableStaging": false
                          },
                          "inputs": [
                            {
                              "referenceName": "data_export_csv_file_initiative",
                              "type": "DatasetReference",
                              "parameters": {
                                "initiativeId": "@pipeline().parameters.initiativeId"
                              }
                            }
                          ],
                          "outputs": [
                            {
                              "referenceName": "data_export_csv_file_bonus_initiative",
                              "type": "DatasetReference",
                              "parameters": {
                                "initiativeFolder": "@pipeline().parameters.initiativeFolder",
                                "initiativeId": "@pipeline().parameters.initiativeId"
                              }
                            }
                          ]
                        }
                      ],
                      "ifFalseActivities": [
                        {
                          "name": "Skip_Unsupported_Initiative",
                          "type": "Wait",
                          "dependsOn": [],
                          "typeProperties": {
                            "waitTimeInSeconds": 1
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "ifFalseActivities": [
            {
              "name": "Skip_No_Config",
              "type": "Wait",
              "dependsOn": [],
              "typeProperties": {
                "waitTimeInSeconds": 1
              }
            }
          ]
        }
      },
      {
        "name": "Generate_SAS",
        "type": "WebActivity",
        "state": "Inactive",
        "onInactiveMarkAs": "Succeeded",
        "dependsOn": [
          {
            "activity": "Route_CSV_Export",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:05:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": true,
          "secureInput": true
        },
        "userProperties": [],
        "typeProperties": {
          "method": "POST",
          "headers": {
            "Content-Type": "application/json"
          },
          "url": {
            "value": "@concat('https://management.azure.com/subscriptions/', string(pipeline().parameters.subscriptionId), '/resourceGroups/', string(pipeline().parameters.resourceGroup), '/providers/Microsoft.Storage/storageAccounts/', string(pipeline().parameters.exportAccountName), '/ListServiceSas?api-version=2023-05-01')",
            "type": "Expression"
          },
          "connectVia": {
            "referenceName": "AutoResolveIntegrationRuntime",
            "type": "IntegrationRuntimeReference"
          },
          "body": {
            "canonicalizedResource": {
              "type": "Expression",
              "value": "@concat('/blob/', pipeline().parameters.exportAccountName, '/', pipeline().parameters.initiativeFolder, '/data/export_daily_', pipeline().parameters.initiativeId, '_', formatDateTime(utcNow(),'yyyy-MM-dd'), '.csv')"
            },
            "signedExpiry": {
              "type": "Expression",
              "value": "@formatDateTime(addDays(utcNow(), 7), 'yyyy-MM-ddTHH:mm:ssZ')"
            },
            "signedResource": "b",
            "signedPermission": "r",
            "signedProtocol": "https",
            "signedStart": {
              "type": "Expression",
              "value": "@utcNow()"
            },
            "signedVersion": "2020-02-10"
          },
          "authentication": {
            "type": "MSI",
            "resource": "https://management.azure.com/"
          }
        }
      },
      {
        "name": "Get_SubKey",
        "type": "WebActivity",
        "state": "Inactive",
        "onInactiveMarkAs": "Succeeded",
        "dependsOn": [
          {
            "activity": "Generate_SAS",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:02:00",
          "retry": 3,
          "retryIntervalInSeconds": 30,
          "secureOutput": true,
          "secureInput": true
        },
        "userProperties": [],
        "typeProperties": {
          "method": "GET",
          "headers": {
            "Content-Type": "application/json"
          },
          "disableCertValidation": false,
          "url": {
            "value": "@concat(pipeline().parameters.kvUrl,'/secrets/', pipeline().parameters.kvSecretName, '?api-version=7.3')",
            "type": "Expression"
          },
          "connectVia": {
            "referenceName": "AutoResolveIntegrationRuntime",
            "type": "IntegrationRuntimeReference"
          },
          "authentication": {
            "type": "MSI",
            "resource": "https://vault.azure.net"
          }
        }
      },
      {
        "name": "Get_NotifyTo",
        "type": "WebActivity",
        "state": "Inactive",
        "onInactiveMarkAs": "Succeeded",
        "dependsOn": [
          {
            "activity": "Get_SubKey",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:02:00",
          "retry": 3,
          "retryIntervalInSeconds": 30,
          "secureOutput": true,
          "secureInput": true
        },
        "userProperties": [],
        "typeProperties": {
          "method": "GET",
          "headers": {
            "Content-Type": "application/json"
          },
          "disableCertValidation": false,
          "url": {
            "value": "@concat(pipeline().parameters.kvUrl,'/secrets/', pipeline().parameters.notifyToSecretName, '?api-version=7.3')",
            "type": "Expression"
          },
          "connectVia": {
            "referenceName": "AutoResolveIntegrationRuntime",
            "type": "IntegrationRuntimeReference"
          },
          "authentication": {
            "type": "MSI",
            "resource": "https://vault.azure.net"
          }
        }
      },
      {
        "name": "Notify_Email_via_MS",
        "type": "WebActivity",
        "state": "Inactive",
        "onInactiveMarkAs": "Succeeded",
        "dependsOn": [
          {
            "activity": "Get_NotifyTo",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:05:00",
          "retry": 3,
          "retryIntervalInSeconds": 30,
          "secureOutput": true,
          "secureInput": true
        },
        "userProperties": [],
        "typeProperties": {
          "method": "POST",
          "headers": {
            "Content-Type": "application/json",
            "Ocp-Apim-Subscription-Key": {
              "value": "@activity('Get_SubKey').output.value",
              "type": "Expression"
            }
          },
          "url": {
            "value": "@pipeline().parameters.notifyUrl",
            "type": "Expression"
          },
          "connectVia": {
            "referenceName": "AutoResolveIntegrationRuntime",
            "type": "IntegrationRuntimeReference"
          },
          "body": {
            "recipientEmail": {
              "type": "Expression",
              "value": "@activity('Get_NotifyTo').output.value"
            },
            "subject": {
              "type": "Expression",
              "value": "@concat('Export giornaliero dei prodotti ', formatDateTime(utcNow(),'yyyy-MM-dd'))"
            },
            "templateName": "Email_ExportDaily_Products",
            "templateValues": {
              "downloadLink": {
                "type": "Expression",
                "value": "@concat('https://', pipeline().parameters.exportAccountName, '.blob.core.windows.net/$web/', pipeline().parameters.initiativeFolder, '/data/export_daily_', pipeline().parameters.initiativeId, '_', formatDateTime(utcNow(),'yyyy-MM-dd'), '.csv?', activity('Generate_SAS').output.serviceSasToken)"
              },
              "exportDate": {
                "type": "Expression",
                "value": "@formatDateTime(utcNow(),'yyyy-MM-dd')"
              },
              "initiativeName": {
                "type": "Expression",
                "value": "@pipeline().parameters.initiativeName"
              },
              "orgName": "PagoPA S.p.A.",
              "productFileName": {
                "type": "Expression",
                "value": "@concat('export_daily_', pipeline().parameters.initiativeId, '_', formatDateTime(utcNow(),'yyyy-MM-dd'), '.csv')"
              }
            }
          }
        }
      }
    ],
    "parameters": {
      "exportAccountName": {
        "type": "String"
      },
      "initiativeFolder": {
        "type": "String"
      },
      "initiativeId": {
        "type": "String"
      },
      "initiativeName": {
        "type": "String"
      },
      "kvSecretName": {
        "type": "String"
      },
      "kvUrl": {
        "type": "String"
      },
      "notifyToSecretName": {
        "type": "String"
      },
      "notifyUrl": {
        "type": "String"
      },
      "resourceGroup": {
        "type": "String"
      },
      "subscriptionId": {
        "type": "String"
      }
    },
    "annotations": []
  },
  "type": "Microsoft.DataFactory/factories/pipelines"
}
