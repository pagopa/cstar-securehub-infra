{
  "name": "idpay_pos_export_daily_stage2",
  "properties": {
    "description": "POS export via double-stage strategy (stage POS + stage initiative, then join)",
    "activities": [
      {
        "name": "StagePosSource",
        "description": "Copy POS records into staging storage",
        "type": "Copy",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "CosmosDbMongoDbApiSource",
            "batchSize": 1000,
            "cursorMethods": {
              "project": "{ \"_id\": 1, \"type\": 1, \"franchiseName\": 1, \"address\": 1, \"city\": 1, \"region\": 1, \"province\": 1, \"streetNumber\": 1, \"zipCode\": 1, \"channelPhone\": 1, \"website\": 1 }"
            }
          },
          "sink": {
            "type": "JsonSink",
            "storeSettings": {
              "type": "AzureBlobFSWriteSettings"
            },
            "formatSettings": {
              "type": "JsonWriteSettings",
              "filePattern": "arrayOfObjects"
            }
          },
          "enableStaging": false,
          "translator": {
            "type": "TabularTranslator",
            "mappings": [
              { "source": { "path": "$['_id']" }, "sink": { "path": "id" } },
              { "source": { "path": "$['type']" }, "sink": { "path": "type" } },
              { "source": { "path": "$['franchiseName']" }, "sink": { "path": "franchiseName" } },
              { "source": { "path": "$['address']" }, "sink": { "path": "address" } },
              { "source": { "path": "$['city']" }, "sink": { "path": "city" } },
              { "source": { "path": "$['region']" }, "sink": { "path": "region" } },
              { "source": { "path": "$['province']" }, "sink": { "path": "province" } },
              { "source": { "path": "$['streetNumber']" }, "sink": { "path": "streetNumber" } },
              { "source": { "path": "$['zipCode']" }, "sink": { "path": "zipCode" } },
              { "source": { "path": "$['channelPhone']" }, "sink": { "path": "channelPhone" } },
              { "source": { "path": "$['website']" }, "sink": { "path": "website" } }
            ]
          }
        },
        "inputs": [
          {
            "referenceName": "cosmos_idpay_pos",
            "type": "DatasetReference"
          }
        ],
        "outputs": [
          {
            "referenceName": "staging_pos_source_json_v2",
            "type": "DatasetReference"
          }
        ]
      },
      {
        "name": "StageInitiativeRecords",
        "description": "Copy filtered point_of_sales_initiative records into staging storage",
        "type": "Copy",
        "dependsOn": [
          {
            "activity": "StagePosSource",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "CosmosDbMongoDbApiSource",
            "batchSize": 500,
            "filter": {
              "value": "@concat('{ \"initiativeId\": \"', pipeline().parameters.initiativeId, '\", \"enabled\": true }')",
              "type": "Expression"
            },
            "cursorMethods": {
              "project": "{ \"_id\": 0, \"initiativeId\": 1, \"enabled\": 1, \"pointOfSaleId\": 1 }"
            }
          },
          "sink": {
            "type": "JsonSink",
            "storeSettings": {
              "type": "AzureBlobFSWriteSettings"
            },
            "formatSettings": {
              "type": "JsonWriteSettings",
              "filePattern": "arrayOfObjects"
            }
          },
          "enableStaging": false
        },
        "inputs": [
          {
            "referenceName": "cosmos_idpay_point_of_sale_initiative",
            "type": "DatasetReference"
          }
        ],
        "outputs": [
          {
            "referenceName": "staging_pos_initiative_source_json_v2",
            "type": "DatasetReference"
          }
        ]
      },
      {
        "name": "ExportPosDataFlowStage2",
        "description": "Join staged POS with staged initiative records and export",
        "type": "ExecuteDataFlow",
        "dependsOn": [
          {
            "activity": "StageInitiativeRecords",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "dataFlow": {
            "referenceName": "export_flow_pos_daily_stage2",
            "type": "DataFlowReference",
            "datasetParameters": {
              "SinkPosJSON": {
                "initiativeFolder": "@pipeline().parameters.initiativeFolder",
                "initiativeId": "@pipeline().parameters.initiativeId"
              }
            }
          },
          "compute": {
            "coreCount": 8,
            "computeType": "General"
          },
          "traceLevel": "Fine"
        }
      }
    ],
    "parameters": {
      "initiativeId": {
        "type": "String"
      },
      "initiativeFolder": {
        "type": "String"
      }
    },
    "annotations": [
      "Point of Sales Export",
      "IdPay",
      "Multi-Initiative",
      "Double Stage Strategy"
    ]
  }
}
