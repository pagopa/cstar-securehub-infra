{
  "name": "idpay_pos_export_daily",
  "properties": {
    "description": "Export Point of Sales from Data Explorer joined table filtered by initiative",
    "activities": [
      {
        "name": "Lookup_Refresh_Status",
        "type": "Lookup",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "AzureDataExplorerSource",
            "query": "export_refresh_status | where datasetName == \"point_of_sales\" | top 1 by refreshTimestamp desc | where status == \"SUCCESS\" and refreshTimestamp > ago(24h)"
          },
          "dataset": {
            "referenceName": "data_explorer_export_refresh_status",
            "type": "DatasetReference"
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "Validate_Pos_Refresh",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "Lookup_Refresh_Status",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "value": "@greater(activity('Lookup_Refresh_Status').output.count, 0)",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "name": "ExportPosFromKusto",
              "description": "Copy POS rows from point_of_sales_export filtered by initiativeId",
              "type": "Copy",
              "dependsOn": [],
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "userProperties": [],
              "typeProperties": {
                "source": {
                  "type": "AzureDataExplorerSource",
                  "query": {
                    "value": "@concat('point_of_sales_export | where initiativeId == \"', pipeline().parameters.initiativeId, '\" | project type, franchiseName, address, city, region, province, streetNumber, zipCode, channelPhone, website')",
                    "type": "Expression"
                  }
                },
                "sink": {
                  "type": "JsonSink",
                  "storeSettings": {
                    "type": "AzureBlobStorageWriteSettings"
                  },
                  "formatSettings": {
                    "type": "JsonWriteSettings",
                    "filePattern": "arrayOfObjects"
                  }
                },
                "enableStaging": false
              },
              "inputs": [
                {
                  "referenceName": "data_explorer_idpay_pos_export",
                  "type": "DatasetReference"
                }
              ],
              "outputs": [
                {
                  "referenceName": "blob_pos_export_initiative",
                  "type": "DatasetReference",
                  "parameters": {
                    "initiativeFolder": "@pipeline().parameters.initiativeFolder",
                    "initiativeId": "@pipeline().parameters.initiativeId"
                  }
                }
              ]
            },
            {
              "name": "Set_POS_JSON_ContentType",
              "description": "Set Content-Type header to application/json for POS export file",
              "type": "WebActivity",
              "dependsOn": [
                {
                  "activity": "ExportPosFromKusto",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "policy": {
                "timeout": "0.00:05:00",
                "retry": 1,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "userProperties": [],
              "typeProperties": {
                "method": "PUT",
                "headers": {
                  "x-ms-blob-content-type": "application/json",
                  "x-ms-version": "2021-12-02"
                },
                "url": {
                  "value": "@concat('https://', pipeline().parameters.exportAccountName, '.blob.core.windows.net/$web/', pipeline().parameters.initiativeFolder, '/lista-punti-vendita/data/pos_export_', pipeline().parameters.initiativeId, '.json?comp=properties')",
                  "type": "Expression"
                },
                "connectVia": {
                  "referenceName": "AutoResolveIntegrationRuntime",
                  "type": "IntegrationRuntimeReference"
                },
                "authentication": {
                  "type": "MSI",
                  "resource": "https://storage.azure.com/"
                }
              }
            }
          ],
          "ifFalseActivities": [
            {
              "name": "Fail_Pos_Refresh",
              "type": "Fail",
              "dependsOn": [],
              "typeProperties": {
                "message": "Required ADX dataset refresh not found.",
                "errorCode": "PosRefreshNotFound"
              }
            }
          ]
        }
      }
    ],
    "parameters": {
      "initiativeId": {
        "type": "String"
      },
      "initiativeFolder": {
        "type": "String"
      },
      "exportAccountName": {
        "type": "String"
      }
    },
    "annotations": [
      "Point of Sales Export",
      "IdPay",
      "Multi-Initiative",
      "Data Explorer"
    ]
  }
}
