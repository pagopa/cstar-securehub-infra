{
    "name": "idpay_pos_export_daily",
    "properties": {
        "description": "Export Point of Sales on daily schedule, filtered by initiative via lookup dataflow",
        "activities": [
            {
                "name": "ExportPosDataFlow",
                "description": "Lookup point_of_sales by point_of_sales_initiative and export filtered by initiativeId",
                "type": "ExecuteDataFlow",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "dataFlow": {
                        "referenceName": "export_flow_pos_daily_lookup",
                        "type": "DataFlowReference",
                        "parameters": {
                            "initiativeId": "@pipeline().parameters.initiativeId"
                        },
                        "datasetParameters": {
                            "SinkPosJSON": {
                                "initiativeFolder": "@pipeline().parameters.initiativeFolder",
                                "initiativeId": "@pipeline().parameters.initiativeId"
                            }
                        }
                    },
                    "compute": {
                        "coreCount": 8,
                        "computeType": "General"
                    },
                    "traceLevel": "Fine"
                }
            }
        ],
        "parameters": {
            "initiativeId": {
                "type": "String"
            },
            "initiativeFolder": {
                "type": "String"
            }
        },
        "annotations": [
            "Point of Sales Export",
            "IdPay",
            "Merchant",
            "Multi-Initiative"
        ]
    }
}
