{
    "name": "idpay_pos_export_daily",
    "properties": {
        "description": "Export Point of Sales on daily schedule",
        "activities": [
            {
                "name": "idpay_pos_export_daily",
                "description": "Export Point of Sales on daily schedule",
                "type": "ExecuteDataFlow",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "dataFlow": {
                        "referenceName": "export_flow_pos_daily",
                        "type": "DataFlowReference",
                        "parameters": {
                            "initiativeId": {
                                "value": "@pipeline().parameters.initiativeId",
                                "type": "Expression"
                            }
                        },
                        "datasetParameters": {
                            "blob_pos_export_daily": {
                                "initiativeFolder": {
                                    "value": "@pipeline().parameters.initiativeFolder",
                                    "type": "Expression"
                                },
                                "fileName": {
                                    "value": "@concat('pos_export_', pipeline().parameters.initiativeId, '.json')",
                                    "type": "Expression"
                                }
                            }
                        }
                    },
                    "compute": {
                        "coreCount": 8,
                        "computeType": "General"
                    }
                }
            }
        ],
        "parameters": {
            "initiativeFolder": {
                "type": "String"
            },
            "initiativeId": {
                "type": "String"
            }
        },
        "annotations": [
            "Point of Sales Export",
            "IdPay",
            "Merchant",
            "Bonus Elettrodomestici"
        ]
    }
}
