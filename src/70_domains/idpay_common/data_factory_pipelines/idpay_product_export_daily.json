{
  "name": "idpay_product_export_daily",
  "properties": {
    "activities": [
      {
        "name": "Lookup_Refresh_Status",
        "type": "Lookup",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "AzureDataExplorerSource",
            "query": "export_refresh_status | where datasetName == \"products\" | top 1 by refreshTimestamp desc | where status == \"SUCCESS\" and refreshTimestamp > ago(24h)"
          },
          "dataset": {
            "referenceName": "data_explorer_export_refresh_status",
            "type": "DatasetReference"
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "Validate_Products_Refresh",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "Lookup_Refresh_Status",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "value": "@greater(activity('Lookup_Refresh_Status').output.count, 0)",
            "type": "Expression"
          },
          "ifTrueActivities": [],
          "ifFalseActivities": [
            {
              "name": "Fail_Products_Refresh",
              "type": "Fail",
              "dependsOn": [],
              "typeProperties": {
                "message": "Required ADX dataset refresh not found.",
                "errorCode": "ProductsRefreshNotFound"
              }
            }
          ]
        }
      },
      {
        "name": "Lookup_Initiative_Export_Configuration",
        "type": "Lookup",
        "dependsOn": [
          {
            "activity": "Validate_Products_Refresh",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "source": {
            "type": "AzureDataExplorerSource",
            "query": {
              "value": "@concat('initiative_export_configuration | where initiativeId == \"', pipeline().parameters.initiativeId, '\" | project fieldsCsv = strcat_array(exportConfiguration.fields, \",\")')",
              "type": "Expression"
            }
          },
          "dataset": {
            "referenceName": "data_explorer_initiative_export_configuration",
            "type": "DatasetReference"
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "Validate_Initiative_Export_Configuration",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "Lookup_Initiative_Export_Configuration",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "value": "@greater(activity('Lookup_Initiative_Export_Configuration').output.count, 0)",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "name": "Copy_ADX_to_Product_JSON",
              "description": "Export product JSON using dynamic projection from initiative configuration",
              "type": "Copy",
              "dependsOn": [],
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "userProperties": [],
              "typeProperties": {
                "source": {
                  "type": "AzureDataExplorerSource",
                  "query": {
                    "value": "@concat('products | where status == \"APPROVED\" and initiativeId == \"', pipeline().parameters.initiativeId, '\" | project ', activity('Lookup_Initiative_Export_Configuration').output.value[0].fieldsCsv)",
                    "type": "Expression"
                  }
                },
                "sink": {
                  "type": "JsonSink",
                  "storeSettings": {
                    "type": "AzureBlobStorageWriteSettings"
                  },
                  "formatSettings": {
                    "type": "JsonWriteSettings",
                    "filePattern": "arrayOfObjects"
                  }
                },
                "enableStaging": false
              },
              "inputs": [
                {
                  "referenceName": "data_explorer_rdb_products",
                  "type": "DatasetReference"
                }
              ],
              "outputs": [
                {
                  "referenceName": "blob_product_export_initiative",
                  "type": "DatasetReference",
                  "parameters": {
                    "initiativeFolder": "@pipeline().parameters.initiativeFolder",
                    "initiativeId": "@pipeline().parameters.initiativeId"
                  }
                }
              ]
            },
            {
              "name": "Set_Product_JSON_ContentType",
              "description": "Set Content-Type header to application/json for Product export file",
              "type": "WebActivity",
              "dependsOn": [
                {
                  "activity": "Copy_ADX_to_Product_JSON",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "policy": {
                "timeout": "0.00:05:00",
                "retry": 1,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "userProperties": [],
              "typeProperties": {
                "method": "PUT",
                "headers": {
                  "x-ms-blob-content-type": "application/json"
                },
                "url": {
                  "value": "@concat('https://', pipeline().parameters.exportAccountName, '.blob.core.windows.net/$web/', pipeline().parameters.initiativeFolder, '/elencoprodotti/data/product_export_', pipeline().parameters.initiativeId, '.json?comp=properties')",
                  "type": "Expression"
                },
                "connectVia": {
                  "referenceName": "AutoResolveIntegrationRuntime",
                  "type": "IntegrationRuntimeReference"
                },
                "authentication": {
                  "type": "MSI",
                  "resource": "https://storage.azure.com/"
                }
              }
            }
          ],
          "ifFalseActivities": [
            {
              "name": "Fail_Initiative_Export_Configuration",
              "type": "Fail",
              "dependsOn": [],
              "typeProperties": {
                "message": "Initiative export configuration not found.",
                "errorCode": "InitiativeExportConfigurationNotFound"
              }
            }
          ]
        }
      }
    ],
    "annotations": [],
    "parameters": {
      "initiativeId": {
        "type": "String"
      },
      "initiativeFolder": {
        "type": "String"
      },
      "exportAccountName": {
        "type": "String"
      }
    }
  },
  "type": "Microsoft.DataFactory/factories/pipelines"
}
