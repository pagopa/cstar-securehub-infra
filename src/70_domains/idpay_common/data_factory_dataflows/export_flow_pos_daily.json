{
    "name": "export_flow_pos_daily",
    "properties": {
        "type": "MappingDataFlow",
        "typeProperties": {
            "sources": [
                {
                    "dataset": {
                        "referenceName": "cosmos_idpay_pos",
                        "type": "DatasetReference"
                    },
                    "name": "PosSource"
                },
                {
                    "dataset": {
                        "referenceName": "cosmos_idpay_pos_initiative",
                        "type": "DatasetReference"
                    },
                    "name": "PosInitiativeSource"
                }
            ],
            "sinks": [
                {
                    "dataset": {
                        "referenceName": "blob_pos_export_daily",
                        "type": "DatasetReference"
                    },
                    "name": "PosExportSink"
                }
            ],
            "transformations": [
                {
                    "name": "NormalizePos"
                },
                {
                    "name": "NormalizeInitiative"
                },
                {
                    "name": "FilterInitiative"
                },
                {
                    "name": "JoinPos"
                },
                {
                    "name": "SelectOutput"
                }
            ],
            "scriptLines": [
                "parameters{",
                "     initiativeId as string",
                "}",
                "source(output(",
                "          _id as string,",
                "          type as string,",
                "          franchiseName as string,",
                "          address as string,",
                "          city as string,",
                "          region as string,",
                "          province as string,",
                "          streetNumber as string,",
                "          zipCode as string,",
                "          channelPhone as string,",
                "          website as string",
                "     ),",
                "     allowSchemaDrift: true,",
                "     validateSchema: false,",
                "     ignoreNoFilesFound: false) ~> PosSource",
                "source(output(",
                "          pointOfSaleId as string,",
                "          posId as string,",
                "          initiativeId as string,",
                "          status as boolean",
                "     ),",
                "     allowSchemaDrift: true,",
                "     validateSchema: false,",
                "     ignoreNoFilesFound: false) ~> PosInitiativeSource",
                "PosSource derive(posIdKey = toString(byName('_id'))) ~> NormalizePos",
                "PosInitiativeSource derive(initiativeIdNorm = toString(byName('initiativeId')),",
                "          initiativeStatus = toBoolean(byName('status')),",
                "          initiativePosIdKey = iif(",
                "            isNull(byName('pointOfSaleId')) || trim(toString(byName('pointOfSaleId'))) == '',",
                "            toString(byName('posId')),",
                "            toString(byName('pointOfSaleId'))",
                "          )) ~> NormalizeInitiative",
                "NormalizeInitiative filter(initiativeIdNorm == $initiativeId && initiativeStatus == true()) ~> FilterInitiative",
                "NormalizePos, FilterInitiative join(posIdKey == initiativePosIdKey,",
                "     joinType:'inner',",
                "     matchType:'exact',",
                "     ignoreSpaces: false,",
                "     broadcast: 'auto')~> JoinPos",
                "JoinPos select(mapColumn(",
                "          type = type,",
                "          franchiseName = franchiseName,",
                "          address = address,",
                "          city = city,",
                "          region = region,",
                "          province = province,",
                "          streetNumber = streetNumber,",
                "          zipCode = zipCode,",
                "          channelPhone = channelPhone,",
                "          website = website",
                "     ),",
                "     skipDuplicateMapInputs: true,",
                "     skipDuplicateMapOutputs: true) ~> SelectOutput",
                "SelectOutput sink(allowSchemaDrift: true,",
                "     validateSchema: false,",
                "     skipDuplicateMapInputs: true,",
                "     skipDuplicateMapOutputs: true,",
                "     partitionBy('hash', 1)) ~> PosExportSink"
            ]
        }
    }
}
