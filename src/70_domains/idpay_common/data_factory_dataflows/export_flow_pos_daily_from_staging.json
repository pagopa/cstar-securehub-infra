{
    "name": "export_flow_pos_daily_from_staging",
    "properties": {
        "type": "MappingDataFlow",
        "typeProperties": {
            "sources": [
                {
                    "dataset": {
                        "referenceName": "staging_pos_source_json",
                        "type": "DatasetReference"
                    },
                    "name": "PosSource"
                },
                {
                    "dataset": {
                        "referenceName": "staging_pos_initiative_source_json",
                        "type": "DatasetReference"
                    },
                    "name": "PosInitiativeSource"
                }
            ],
            "sinks": [
                {
                    "dataset": {
                        "referenceName": "blob_pos_export_daily",
                        "type": "DatasetReference"
                    },
                    "name": "PosExportSink"
                }
            ],
            "transformations": [
                {
                    "name": "NormalizePos"
                },
                {
                    "name": "FilterPosKeys"
                },
                {
                    "name": "NormalizeInitiative"
                },
                {
                    "name": "FilterInitiative"
                },
                {
                    "name": "FilterInitiativeKeys"
                },
                {
                    "name": "JoinPos"
                },
                {
                    "name": "SelectOutput"
                }
            ],
            "scriptLines": [
                "parameters{",
                "     initiativeId as string",
                "}",
                "source(output(",
                "          _id as string,",
                "          id as string,",
                "          posId as string,",
                "          merchantId as string,",
                "          type as string,",
                "          franchiseName as string,",
                "          address as string,",
                "          city as string,",
                "          region as string,",
                "          province as string,",
                "          streetNumber as string,",
                "          zipCode as string,",
                "          channelPhone as string,",
                "          website as string",
                "     ),",
                "     allowSchemaDrift: true,",
                "     validateSchema: false,",
                "     ignoreNoFilesFound: false) ~> PosSource",
                "source(output(",
                "          pointOfSaleId as string,",
                "          posId as string,",
                "          point_of_sale_id as string,",
                "          initiativeId as string,",
                "          initiative_id as string,",
                "          merchantId as string,",
                "          enabled as string",
                "     ),",
                "     allowSchemaDrift: true,",
                "     validateSchema: false,",
                "     ignoreNoFilesFound: false) ~> PosInitiativeSource",
                "PosSource derive(posIdKey = trim(iif(!isNull(_id) && trim(_id) != '', _id, iif(!isNull(id) && trim(id) != '', id, posId))),",
                "          merchantIdKey = trim(merchantId)) ~> NormalizePos",
                "NormalizePos filter(!isNull(posIdKey) && trim(posIdKey) != '' && !isNull(merchantIdKey) && trim(merchantIdKey) != '') ~> FilterPosKeys",
                "PosInitiativeSource derive(initiativeIdNorm = trim(iif(!isNull(initiativeId) && trim(initiativeId) != '', initiativeId, initiative_id)),",
                "          initiativeEnabledNorm = lower(trim(enabled)),",
                "          initiativeEnabled = initiativeEnabledNorm == 'true' || initiativeEnabledNorm == '1',",
                "          initiativePosIdKey = trim(iif(!isNull(pointOfSaleId) && trim(pointOfSaleId) != '', pointOfSaleId, iif(!isNull(posId) && trim(posId) != '', posId, point_of_sale_id))),",
                "          initiativeMerchantIdKey = trim(merchantId)) ~> NormalizeInitiative",
                "NormalizeInitiative filter(initiativeIdNorm == $initiativeId && initiativeEnabled == true()) ~> FilterInitiative",
                "FilterInitiative filter(!isNull(initiativePosIdKey) && trim(initiativePosIdKey) != '' && !isNull(initiativeMerchantIdKey) && trim(initiativeMerchantIdKey) != '') ~> FilterInitiativeKeys",
                "FilterPosKeys, FilterInitiativeKeys join(posIdKey == initiativePosIdKey && merchantIdKey == initiativeMerchantIdKey,",
                "     joinType:'inner',",
                "     matchType:'exact',",
                "     ignoreSpaces: false,",
                "     broadcast: 'auto')~> JoinPos",
                "JoinPos select(mapColumn(type = type, franchiseName = franchiseName, address = address, city = city, region = region, province = province, streetNumber = streetNumber, zipCode = zipCode, channelPhone = channelPhone, website = website), skipDuplicateMapInputs: true, skipDuplicateMapOutputs: true) ~> SelectOutput",
                "SelectOutput sink(allowSchemaDrift: true, validateSchema: false, skipDuplicateMapInputs: true, skipDuplicateMapOutputs: true, partitionBy('hash', 1)) ~> PosExportSink"
            ]
        }
    }
}
