{
  "name": "export_flow_pos_daily_lookup",
  "properties": {
    "type": "MappingDataFlow",
    "typeProperties": {
      "sources": [
        {
          "dataset": {
            "referenceName": "cosmos_idpay_point_of_sale_initiative",
            "type": "DatasetReference"
          },
          "name": "PosInitiativeSource"
        },
        {
          "dataset": {
            "referenceName": "cosmos_idpay_pos",
            "type": "DatasetReference"
          },
          "name": "PosSource"
        }
      ],
      "sinks": [
        {
          "dataset": {
            "referenceName": "blob_pos_export_initiative",
            "type": "DatasetReference"
          },
          "name": "SinkPosJSON"
        }
      ],
      "transformations": [
        { "name": "FilterInitiative" },
        { "name": "LookupPos" },
        { "name": "FilterMatched" },
        { "name": "SelectOutput" }
      ],
      "scriptLines": [
        "parameters{",
        "     initiativeId as string",
        "}",
        "source(allowSchemaDrift: true,",
        "     validateSchema: false,",
        "     ignoreNoFilesFound: false) ~> PosInitiativeSource",
        "source(allowSchemaDrift: true,",
        "     validateSchema: false,",
        "     ignoreNoFilesFound: false) ~> PosSource",
        "PosInitiativeSource filter(",
        "     toString(byName('initiativeId')) == $initiativeId",
        "     && toBoolean(byName('enabled')) == true()",
        ") ~> FilterInitiative",
        "FilterInitiative, PosSource lookup(toString(FilterInitiative@pointOfSaleId) == toString(PosSource@id),",
        "     multiple: false,",
        "     pickup: 'any',",
        "     broadcast: 'auto') ~> LookupPos",
        "LookupPos filter(!isNull(PosSource@id)) ~> FilterMatched",
        "FilterMatched select(mapColumn(",
        "          type = PosSource@type,",
        "          franchiseName = PosSource@franchiseName,",
        "          address = PosSource@address,",
        "          city = PosSource@city,",
        "          region = PosSource@region,",
        "          province = PosSource@province,",
        "          streetNumber = PosSource@streetNumber,",
        "          zipCode = PosSource@zipCode,",
        "          channelPhone = PosSource@channelPhone,",
        "          website = PosSource@website",
        "     ),",
        "     skipDuplicateMapInputs: true,",
        "     skipDuplicateMapOutputs: true) ~> SelectOutput",
        "SelectOutput sink(allowSchemaDrift: true,",
        "     validateSchema: false,",
        "     skipDuplicateMapInputs: true,",
        "     skipDuplicateMapOutputs: true) ~> SinkPosJSON"
      ]
    }
  }
}
