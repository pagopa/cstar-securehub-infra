{
  "sampling": {
    "percentage": 100,
    "overrides": [
      {
        "telemetryType": "request",
        "percentage": 100
      },
      {
        "telemetryType": "dependency",
        "percentage": 100
      },
      {
        "telemetryType": "trace",
        "percentage": 100
      },
      {
        "telemetryType": "exception",
        "percentage": 100
      }
    ]
  },
  "preview": {
    "processors": [
      {
        "type": "metric-filter",
        "exclude": {
          "matchType": "strict",
          "metricNames": [
            "Loaded Class Count",
            "Heap Memory Used (MB)",
            "Suspected Deadlocked Threads",
            "Current Thread Count",
            "GC Total Time",
            "GC Total Count",
            "% Of Max Heap Memory Used",
            "http.server.response.size",
            "http.server.request.size",
            "http.client.response.size",
            "http.client.request.size"
          ]
        }
      }
    ]
  }
}
