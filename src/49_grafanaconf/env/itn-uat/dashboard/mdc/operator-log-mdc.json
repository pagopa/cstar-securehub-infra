        {
          "azureLogAnalytics": {
            "dashboardTime": false,
            "mode": "raw",
            "query": "AppTraces\r\n| where $__timeFilter(TimeGenerated)\r\n| where AppRoleName == \"emdarbackofficebff\"\r\n| where Message has \"[AR-BFF]\"\r\n| extend \r\n    RawOp = extract(@\"\\[AR-BFF\\]\\[([A-Z0-9_]+)\\]\", 1, Message),\r\n    UserEmail = extract(@\"\\[User:([^\\]]+)\\]\", 1, Message),\r\n    SeverityName = case(\r\n        SeverityLevel == 0, \"Verbose\",\r\n        SeverityLevel == 1, \"Info\",\r\n        SeverityLevel == 2, \"Warning\",\r\n        SeverityLevel == 3, \"Error\",\r\n        SeverityLevel == 4, \"Critical\",\r\n        tostring(SeverityLevel)\r\n    )\r\n| extend \r\n    OperationGroup = case(\r\n        RawOp startswith \"MESSAGE\",         \"Messaggi\",\r\n        RawOp startswith \"CITIZEN\",         \"Cittadini\",\r\n        RawOp startswith \"PAYMENT_ATTEMPT\", \"Pagamenti\",\r\n        RawOp startswith \"TPP\",             \"TPP\",\r\n        RawOp startswith \"KC\",              \"Keycloak\",\r\n        RawOp startswith \"GET_PAGOPA_CREDENTIALS\", \"Keycloak\", \r\n        RawOp startswith \"VERIFY_CLAIMS\", \"Keycloak\", \r\n        RawOp startswith \"VALIDATE_SC_TOKEN\", \"Keycloak\",\r\n        RawOp startswith \"GET_KC_USER\", \"Keycloak\", \r\n        RawOp startswith \"DELETE_CLIENT\", \"Keycloak\", \r\n        RawOp startswith \"EXCHANGE_TOKEN\", \"Keycloak\", \r\n        RawOp startswith \"LINK_IDENTITY\", \"Keycloak\",\r\n        RawOp startswith \"UPSERT_USER\", \"Keycloak\",\r\n        RawOp startswith \"SELFCARE\",        \"Selfcare\",\r\n        \"Altro\"\r\n    ),\r\n    UserDisplay = iif(isnotempty(UserEmail), UserEmail, \"N/A\")\r\n| where ('$OperationGroup' == 'All' or OperationGroup == '$OperationGroup')\r\n| where ('$User' == 'All' or UserDisplay == '$User')\r\n| where ('$Severity' == 'All' or SeverityName == '$Severity')\r\n| project \r\n    TimeGenerated, \r\n    Severity = SeverityName,\r\n    Group = OperationGroup, \r\n    Operation = RawOp, \r\n    User = UserDisplay, \r\n    Message\r\n| sort by TimeGenerated desc",
            "resources": [
              "/subscriptions/4d177dd6-5c7d-40ab-8019-0c1be380a25d"
