      "targets": [
        {
          "azureLogAnalytics": {
            "dashboardTime": true,
            "mode": "raw",
            "query": "AppMetrics\n| where $__timeFilter(TimeGenerated)\n| where Name startswith \"keycloak_user\"\n| extend\n    realm     = tostring(Properties[\"realm\"]),\n    client_id = iff(isnotempty(tostring(Properties[\"client_id\"])), tostring(Properties[\"client_id\"]), tostring(Properties[\"clientId\"])),\n    event     = tostring(Properties[\"event\"]),\n    error     = tostring(Properties[\"error\"])\n| where realm == \"srtp\"\n| summarize\n    ['Eventi']     = sum(todouble(Sum)),\n    ['Ultima osservazione'] = max(TimeGenerated),\n    ['Prima osservazione']  = min(TimeGenerated)\n    by client_id, event, error\n| extend\n    ['Ultima osservazione'] = format_datetime(['Ultima osservazione'], \"yyyy-MM-dd HH:mm:ss\"),\n    ['Prima osservazione']  = format_datetime(['Prima osservazione'],  \"yyyy-MM-dd HH:mm:ss\")\n| order by ['Eventi'] desc\n| project\n    ['Client ID']        = client_id,\n    ['Evento']           = event,\n    ['Errore']           = iff(error == \"\", \"-\", error),\n    ['Eventi'],\n    ['Prima osservazione'],\n    ['Ultima osservazione']",
            "resources": [
              "/subscriptions/$subscription/resourceGroups/$CoreMonitoringRg/providers/Microsoft.OperationalInsights/workspaces/$CoreLaw"
            ],
            "resultFormat": "table",
            "timeColumn": "TimeGenerated"
          },
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "azure-monitor-oob"
          },
          "queryType": "Azure Log Analytics",
          "refId": "A",
          "subscription": "$subscription"
        }
      ],
      "title": "Panoramica eventi di autenticazione (Metriche Keycloak)",
