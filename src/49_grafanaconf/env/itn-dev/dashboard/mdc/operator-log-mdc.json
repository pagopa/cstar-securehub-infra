      "targets": [
        {
          "azureLogAnalytics": {
            "dashboardTime": false,
            "mode": "raw",
            "query": "AppTraces\r\n| where $__timeFilter(TimeGenerated)\r\n| where AppRoleName == \"emdarbackofficebff\"\r\n| where Message has \"[AR-BFF]\"\r\n| extend \r\n    RawOp = extract(@\"\\[AR-BFF\\]\\[([A-Z0-9_]+)\\]\", 1, Message),\r\n    UserEmail = extract(@\"\\[User:([^\\]]+)\\]\", 1, Message),\r\n    SeverityName = case(\r\n                   SeverityLevel == 0,\r\n                   \"Verbose\",\r\n                   SeverityLevel == 1,\r\n                   \"Info\",\r\n                   SeverityLevel == 2,\r\n                   \"Warning\",\r\n                   SeverityLevel == 3,\r\n                   \"Error\",\r\n                   SeverityLevel == 4,\r\n                   \"Critical\",\r\n                   tostring(SeverityLevel)\r\n               )\r\n| extend \r\n    OperationGroup = case(\r\n                     RawOp startswith \"MESSAGE\",\r\n                     \"Messaggi\",\r\n                     RawOp startswith \"CITIZEN\",\r\n                     \"Cittadini\",\r\n                     RawOp startswith \"PAYMENT_ATTEMPT\",\r\n                     \"Pagamenti\",\r\n                     RawOp startswith \"TPP\",\r\n                     \"TPP\",\r\n                     RawOp startswith \"KC\",\r\n                     \"Keycloak\",\r\n                     RawOp startswith \"GET_PAGOPA_CREDENTIALS\",\r\n                     \"Keycloak\", \r\n                     RawOp startswith \"VERIFY_CLAIMS\",\r\n                     \"Keycloak\", \r\n                     RawOp startswith \"VALIDATE_SC_TOKEN\",\r\n                     \"Keycloak\",\r\n                     RawOp startswith \"GET_KC_USER\",\r\n                     \"Keycloak\", \r\n                     RawOp startswith \"DELETE_CLIENT\",\r\n                     \"Keycloak\", \r\n                     RawOp startswith \"EXCHANGE_TOKEN\",\r\n                     \"Keycloak\", \r\n                     RawOp startswith \"LINK_IDENTITY\",\r\n                     \"Keycloak\",\r\n                     RawOp startswith \"UPSERT_USER\",\r\n                     \"Keycloak\",\r\n                     RawOp startswith \"SELFCARE\",\r\n                     \"Selfcare\",\r\n                     \"Altro\"\r\n                 ),\r\n    UserDisplay = iif(isnotempty(UserEmail), UserEmail, \"N/A\")\r\n| where Message !contains \"SEARCH\"\r\n| where ('$OperationGroup' == 'All' or OperationGroup == '$OperationGroup')\r\n| where ('$Severity' == 'All' or SeverityName == '$Severity')\r\n| where isempty('${User}') or UserDisplay startswith '${User}'\r\n| where isempty('${messageId}') or Message has '${messageId}'\r\n| where isempty('${originId}') or Message has '${originId}'\r\n| where isempty('${tppId}') or Message has '${tppId}'\r\n| project \r\n    TimeGenerated, \r\n    Severity = SeverityName,\r\n    Group = OperationGroup, \r\n    Operation = RawOp, \r\n    User = UserDisplay, \r\n    Message\r\n| sort by TimeGenerated desc",
            "resources": [
              "$workspace"
            ],
            "resultFormat": "logs"
          },
          "azureMonitor": {
            "allowedTimeGrainsMs": [],
            "timeGrain": "auto"
          },
          "queryType": "Azure Log Analytics",
          "refId": "A"
        }
      ],
      "title": "BFF Logs",
